generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The parent/key identity: a verified phone number or email.
// A User can hold multiple Profiles (2 free on signup).
model User {
  id        String    @id @default(cuid())
  phone     String?   @unique
  email     String?   @unique
  createdAt DateTime  @default(now())
  // Deactivation (not a hard delete — see routes/users.ts): login via
  // /auth/verify-otp is refused once this is set, and the identifier can
  // never be reclaimed for a new account.
  deletedAt DateTime?

  profiles      Profile[]
  subscriptions Subscription[]
}

// Recurring paid entitlements (see routes/subscriptions.ts) — currently only
// "podcast" (a podcast-kind profile is never free; see routes/profiles.ts's
// kind==="podcast" gate). One active row unlocks exactly one profile slot of
// that kind, same way the 2 free slots work for personal/business.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  kind   String // "podcast" — free-form, same spirit as Profile.kind

  status                   String    @default("pending") // "pending" | "active" | "cancelled" | "expired"
  reference                String    @unique // our own, same pattern as PaystackPayment.reference
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  planCode                 String
  currentPeriodEnd         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind, status])
}

// Short-lived verification code sent to a phone or email during sign up / sign in.
model OtpCode {
  id         String   @id @default(cuid())
  identifier String // phone number or email this code was sent to
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
}

// A single WAY identity (WAY-ID). Each User gets 2 free profiles and can run
// them independently, e.g. a personal profile and a business profile.
model Profile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  wayId             String   @unique // the handle people search for / ask for socially as "your WAY"
  displayName       String
  displayPictureUrl String?
  bio               String?
  categories        String[] @default([]) // interests / category tags used for search filtering
  kind              String   @default("personal") // free-form label, e.g. "personal" | "business"
  isVerified        Boolean  @default(false)

  // One of a small fixed set of permanent, non-interactive profiles —
  // LowC (personal, memorial), WAY Ltd (business), WayCast (podcast) —
  // auto-followed by every new profile of the matching kind at signup.
  // No Follow/Unfollow control is ever shown for a profile with this set
  // (see FollowButton.tsx and routes/follow.ts's guard). defaultLabel is
  // the distinct, human-readable reason shown wherever it appears (e.g.
  // "In Loving Memory"), not a single generic badge shared across all of
  // them — these are different in kind, not interchangeable "defaults".
  isDefault    Boolean @default(false)
  defaultLabel String?

  // The default answer to "what's your WAY" when a user has more than one
  // profile — exactly one true per user, enforced in application code (see
  // PATCH /profiles/:id/primary), not a DB constraint. The wayId model
  // itself stays flat/global (see project memory on username structure);
  // this is just a default-selection flag layered on top of it.
  isPrimary Boolean @default(false)

  followersCount Int @default(0)
  followingCount Int @default(0)

  // Visibility controls (feature 4): a profile can be found on none, some, or all
  // search modes, and can carry a visibility text/image shown in its mini-profile.
  isVisible          Boolean @default(true)
  visibleToNearby    Boolean @default(true)
  visibleToAddress   Boolean @default(true)
  visibleToLocation  Boolean @default(true)
  visibilityText     String?
  visibilityImageUrl String?

  // Can someone who has this account's phone number find this profile at
  // all (the WAY-ID/phone search already existed unconditionally before
  // this — this adds the missing opt-out). Defaults true to preserve that
  // existing behavior. This is the only phone-privacy setting that's
  // general/blanket — whether a found profile's actual number gets shown
  // back is never general, see WayRequest's fromSharesPhone/toSharesPhone.
  discoverableByPhone Boolean @default(true)

  // Short, optional "what you do/offer/are into" teaser shown alongside the
  // mini-profile card and used as search-matchable free text (see
  // lib/describeMatch.ts) — separate from visibilityText, which is a
  // purely decorative caption, not search data.
  whichWay          String?
  // Voyage AI embedding of whichWay (see lib/voyage.ts), used by
  // geo.ts's semantic ranking of "describe" searches. Empty = never
  // embedded yet (no whichWay, or VOYAGE_API_KEY unset at save time) —
  // callers always fall back to plain ILIKE matching in that case.
  whichWayEmbedding Float[] @default([])

  // Auto-grant-full-profile-access rules (feature: profile access), evaluated
  // only for an *accepted* connector (see lib/profileAccess.ts) — never for a
  // stranger who hasn't connected. Each group is independent and OR'd
  // together: access is granted if the connector matched via EITHER how they
  // found you OR what kind of profile they are, not both at once.
  autoGrantAccessViaNearby   Boolean @default(false)
  autoGrantAccessViaAddress  Boolean @default(false)
  autoGrantAccessViaLocation Boolean @default(false)
  autoGrantAccessToPersonal  Boolean @default(false)
  autoGrantAccessToBusiness  Boolean @default(false)
  autoGrantAccessToPodcast   Boolean @default(false)

  // Who can start a new DM with this profile (routes/messages.ts's
  // POST /conversations). Only gates brand-new conversations — an existing
  // thread is never retroactively locked out by a later privacy change.
  messagePrivacy String @default("everyone") // "everyone" | "following" | "no_one"

  // Per-type notification preferences. A preference being false never blocks
  // the underlying action — it only suppresses the alert (push and/or the
  // in-app Notification row) for this profile. Accept-confirmation pushes
  // (way-request accepted, camera access granted) are intentionally ungated
  // everywhere, since they're a direct response to the user's own action.
  notifyLikes                 Boolean @default(true)
  notifyComments              Boolean @default(true)
  notifyFollows               Boolean @default(true)
  notifyMessages              Boolean @default(true)
  notifyCalls                 Boolean @default(true)
  notifyLive                  Boolean @default(true)
  notifyWayRequests           Boolean @default(true)
  notifyCameraRequests        Boolean @default(true)
  notifyProfileAccessRequests Boolean @default(true)
  // Weekly digest (feature 8): batches likes/comments/follows — the three
  // types above that never push on their own — into one periodic push.
  // lastDigestSentAt drives both the per-profile counting window and the
  // "only one caller wins" claim in routes/digest.ts; null until this
  // profile's first digest run.
  notifyDigest     Boolean   @default(true)
  lastDigestSentAt DateTime?

  // Location (feature 5): a profile's displayed location can be overridden to
  // anywhere on earth; actualLat/actualLng always hold the real device location.
  actualLat            Float?
  actualLng            Float?
  displayLat           Float?
  displayLng           Float?
  isLocationOverridden Boolean   @default(false)
  lastActiveAt         DateTime?

  // Kept in sync with displayLat/displayLng via raw SQL on write; used for
  // fast radius search with PostGIS (ST_DWithin / ST_Distance / ST_Azimuth).
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())

  posts  Post[]
  wallet Wallet?

  pushTokens   PushToken[]
  liveSessions LiveSession[]
  supportConversation SupportConversation?

  linksFrom ProfileLink[] @relation("ProfileLinksFrom")
  linksTo   ProfileLink[] @relation("ProfileLinksTo")

  episodes Episode[]

  @@index([userId])
}

// Podcast-profile content (profile-kind feature phase 4) — deliberately
// separate from Post rather than another Post.type, since episodes have
// their own required `title` and never go through the regular post
// composer/feed. Only a profile with kind "podcast" may own these,
// enforced in routes/episodes.ts, not at the schema level.
model Episode {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id])
  title         String
  type          String // "audio" | "video"
  mediaUrl      String
  // Shown behind the decorative looping animation while an audio episode
  // plays; unused for video episodes (the video frame is the art).
  coverImageUrl String?
  playsCount    Int      @default(0)
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  sharesCount   Int      @default(0)
  createdAt     DateTime @default(now())

  // Transcription pipeline (lib/transcription.ts = Deepgram,
  // lib/episodeShowNotes.ts = Claude) — kicked off automatically on
  // creation, see routes/episodes.ts. "none" means never attempted
  // (DEEPGRAM_API_KEY unset at creation time, or created before this
  // feature shipped — see scripts/backfill-episode-transcripts.ts).
  transcript       String?
  showNotes        String?
  transcriptStatus String  @default("none") // "none" | "pending" | "ready" | "failed"

  likes    EpisodeLike[]
  comments EpisodeComment[]

  @@index([profileId, createdAt])
  @@index([createdAt])
}

// Mirrors Like, but kept as its own model rather than making Like
// polymorphic — Episode was already deliberately kept separate from Post
// at the schema level (see above), and splitting Like's
// @@unique([postId, profileId]) into two nullable-FK variants would be
// real churn on a table Post's whole reaction system depends on, for no
// benefit over a straight parallel copy. No `type` field here (unlike
// Like's 6 reaction variants) — this is a plain like/unlike toggle.
model EpisodeLike {
  id        String   @id @default(cuid())
  episodeId String
  profileId String
  createdAt DateTime @default(now())

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, profileId])
  @@index([profileId])
}

// Mirrors Comment, same reasoning as EpisodeLike above.
model EpisodeComment {
  id        String   @id @default(cuid())
  episodeId String
  profileId String
  text      String
  createdAt DateTime @default(now())

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, createdAt])
}

// A cross-link from one of a user's own profiles to another, shown to
// viewers of `profile` as "also on WAY as {linkedProfile}". Owner-controlled
// per source profile (feature: profile-kind cross-linking) — a row's mere
// existence means the link is shown; there's no separate visibility flag.
// Both profiles must belong to the same user, enforced in routes/profiles.ts
// rather than at the schema level (Prisma can't express a same-parent
// constraint across two FKs).
model ProfileLink {
  id              String   @id @default(cuid())
  profileId       String
  profile         Profile  @relation("ProfileLinksFrom", fields: [profileId], references: [id])
  linkedProfileId String
  linkedProfile   Profile  @relation("ProfileLinksTo", fields: [linkedProfileId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([profileId, linkedProfileId])
  @@index([profileId])
}

// A connection request sent from one profile to another after finding them
// through search (feature 2). Media is a URL into object storage — uploading
// the file there is a separate concern from this record.
model WayRequest {
  id            String    @id @default(cuid())
  fromProfileId String
  toProfileId   String
  text          String?
  mediaUrl      String?
  mediaType     String? // "image" | "video"
  status        String    @default("pending") // pending | accepted | declined
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  // How the sender found the recipient (set by the mobile client at send
  // time) — "nearby" | "address" | "location" | "wayid" | "all" | "qr", or
  // null if the client didn't record one. Drives Profile.autoGrantAccessVia*
  // once this request is accepted (see lib/profileAccess.ts) and is shown
  // back to the viewer on the full-profile page once connected (see
  // getConnectionDiscoveredVia there) — "qr" never matches any
  // autoGrantAccessVia* rule, all of which are search-specific.
  discoveredVia String?

  // Phone-number sharing is per-connection, never general — each side
  // independently controls whether THEY share THEIR OWN number with the
  // other person on this specific connection, never a blanket "share with
  // anyone who finds me" switch. fromSharesPhone is fromProfile's choice
  // (whether fromProfile's number is shown to toProfile); toSharesPhone is
  // toProfile's choice, the opposite direction. Both default false. The
  // recipient (toProfile — the only side that can ever accept) is offered
  // toSharesPhone inline at accept time (see POST .../accept) but either
  // side can change their own flag anytime after from the other person's
  // profile page — see PATCH /profiles/:id/share-phone.
  fromSharesPhone Boolean @default(false)
  toSharesPhone   Boolean @default(false)

  @@index([fromProfileId])
  @@index([toProfileId, status])
}

// A request to escalate from "restricted" to "full" access on someone's
// profile page (see lib/profileAccess.ts) — distinct from WayRequest
// ("Connect"), which is the underlying connection itself. Shaped identically
// to WayRequest/RemoteCameraRequest's status convention.
model ProfileAccessRequest {
  id            String    @id @default(cuid())
  fromProfileId String
  toProfileId   String
  message       String?
  status        String    @default("pending") // pending | accepted | declined
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  @@index([fromProfileId])
  @@index([toProfileId, status])
}

// A timeline post (feature: profile timeline). Text-only, image, or video —
// mediaUrl points into object storage, same caveat as WayRequest.mediaUrl.
model Post {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id])
  type          String // "text" | "image" | "video" | "event" | "repost"
  mediaUrl      String?
  caption       String?
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  sharesCount   Int      @default(0)
  viewsCount    Int      @default(0)
  createdAt     DateTime @default(now())

  // Event-only fields (type: "event") — an event is a post with these set,
  // so it rides the same like/comment/share/view pipeline as any other post
  // rather than needing its own. `eventLocation` is deliberately free text
  // (an address, a Google Maps link, a landmark name, "online") rather than
  // a structured place lookup — matches how loosely people actually
  // describe where something is. `eventCategories` mirrors
  // Profile.categories so event search can filter by the same kind of
  // interest tag people already use to describe themselves.
  eventTitle      String?
  eventLocation   String?
  eventStartsAt   DateTime?
  eventCategories String[]  @default([])
  // Post.mediaUrl doubles as the event's cover photo/video; this says which
  // it is, mirroring the top-level type field's own image/video distinction
  // since "event" itself doesn't tell you that.
  eventMediaType  String? // "image" | "video"

  likes    Like[]
  comments Comment[]

  // A "repost" (type: "repost") has no caption/mediaUrl of its own — it's a
  // thin pointer to the original, always re-pointed at the ORIGINAL post
  // even when reposted via an existing repost (no chains). Cross-profile
  // content sharing (profile-kind feature phase 3): always owner-to-own-
  // other-profile, enforced in routes/posts.ts, not at the schema level.
  sharedFromPostId String?
  sharedFromPost   Post?   @relation("PostShares", fields: [sharedFromPostId], references: [id])
  shares           Post[]  @relation("PostShares")

  @@index([profileId, createdAt])
  @@index([createdAt])
  @@index([type, eventStartsAt])
}

// One reaction per (post, profile) — the single unique row's "type" field
// is what expanded this from a plain like into a reaction, so a switch
// between emoji is an update to the existing row rather than a new one.
// Post.likesCount is the total reaction count of any type, not "likes"
// specifically — the field name stayed as-is since it's read everywhere.
model Like {
  id        String   @id @default(cuid())
  postId    String
  profileId String
  type      String   @default("like") // "like" | "love" | "haha" | "wow" | "sad" | "angry"
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([profileId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  profileId String
  text      String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// One wallet per profile (not per user) — profiles run independently
// everywhere else in the app, so their finances stay separate too.
model Wallet {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())

  balances     WalletBalance[]
  transactions Transaction[]
}

// A wallet can hold a balance in several currencies at once (feature: no
// auto-conversion — funding and sending both happen in a single currency).
model WalletBalance {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])
  currency String // ISO 4217 code, see lib/currency.ts ALLOWED_CURRENCIES
  amount   Int    @default(0) // minor units (cents/kobo) — never a float

  @@unique([walletId, currency])
}

// One row per wallet per side of an event: a transfer writes two rows (one
// "transfer_out" on the sender's wallet, one "transfer_in" on the
// receiver's), sharing groupId, so "history with this specific person" is
// just a filter on counterpartyProfileId.
model Transaction {
  id                    String   @id @default(cuid())
  walletId              String
  wallet                Wallet   @relation(fields: [walletId], references: [id])
  groupId               String // links the two legs of a transfer; unique per fund
  type                  String // "fund" | "transfer_out" | "transfer_in"
  currency              String
  amount                Int // minor units, always positive — sign is implied by type
  counterpartyProfileId String?
  method                String? // for type "fund": "card" | "crypto"
  description           String?
  createdAt             DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([walletId, counterpartyProfileId])
}

// An automated risk flag on a transfer (see lib/fraudDetection.ts),
// written after the transfer already completed — this app's policy is
// "allow + flag for review," not block/hold, so there's no reversal
// mechanism here; any real follow-up (blocking the profile, contacting
// the user) stays a manual step outside this system, same as Report's
// own stated scope. groupId links back to the transfer's own
// Transaction.groupId.
model WalletFraudFlag {
  id                    String   @id @default(cuid())
  profileId             String // the sender being flagged
  groupId               String
  counterpartyProfileId String
  currency              String
  amount                Int
  score                 Float
  reasons               String[] // short rule-based explanations, e.g. "Rapid succession of transfers"
  status                String   @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt             DateTime @default(now())

  @@index([profileId])
  @@index([status])
}

// A real Paystack checkout in flight. Created "pending" when we ask Paystack
// to open a hosted checkout page, flipped to "success"/"failed" only once
// /wallet/fund/verify has actually confirmed it with Paystack — the
// WalletBalance/Transaction credit happens at that point, not before, so a
// user closing the browser mid-payment can't credit themselves.
model PaystackPayment {
  id         String    @id @default(cuid())
  profileId  String
  currency   String
  amount     Int // minor units (kobo for NGN) — what we asked Paystack to charge
  reference  String    @unique
  status     String    @default("pending") // "pending" | "success" | "failed"
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@index([profileId])
}

// A minimal follow graph — exists mainly so "notify my followers" (going
// live) has someone real to target. Profile.followersCount/followingCount
// are kept in sync transactionally on follow/unfollow.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  // Set when this row was created by the default-profile auto-follow
  // mechanism (see routes/profiles.ts's POST /profiles), never by a
  // user's own Follow button. The target's followersCount is
  // incremented normally for these, but the follower's own
  // followingCount deliberately is not — this flag is what lets unfollow
  // logic mirror that same asymmetry instead of drifting the count.
  isAutoFollow Boolean @default(false)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// One push token per (profile, device, type). A profile registers its
// device's token while signed in; "notify followers" fans out to every
// token belonging to every profile that follows the broadcaster.
// "type" distinguishes a regular Expo push token from an iOS VoIP
// (PushKit) token — the two use entirely different delivery paths
// (lib/expoPush.ts vs lib/apnsVoipPush.ts) and must never be mixed.
model PushToken {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  token     String
  type      String   @default("expo") // "expo" | "voip"
  createdAt DateTime @default(now())

  @@unique([profileId, token, type])
}

// A go-live broadcast (feature 15). The video transport itself is stubbed —
// see README — but scheduling, status, viewer count, and chat are all real.
model LiveSession {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id])
  title        String?
  status       String    @default("scheduled") // "scheduled" | "live" | "ended"
  scheduledFor DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  viewerCount  Int       @default(0)
  createdAt    DateTime  @default(now())

  chatMessages LiveChatMessage[]

  @@index([status])
  @@index([profileId, createdAt])
}

model LiveChatMessage {
  id            String      @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  profileId     String
  text          String
  createdAt     DateTime    @default(now())

  @@index([liveSessionId, createdAt])
}

// A request to remotely activate another profile's camera/mic (feature 16 —
// e.g. a journalist asking a witness to point their camera at something).
// Nothing streams until the target explicitly accepts; accepting creates a
// RemoteCameraSession. The target can end that session at any time.
model RemoteCameraRequest {
  id            String    @id @default(cuid())
  fromProfileId String // wants to view the stream
  toProfileId   String // owns the camera being asked for
  message       String?
  status        String    @default("pending") // "pending" | "accepted" | "declined"
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  @@index([toProfileId, status])
  @@index([fromProfileId])
}

model RemoteCameraSession {
  id          String    @id @default(cuid())
  requestId   String    @unique
  granterId   String // the camera owner — the only one actually broadcasting
  requesterId String // the viewer
  status      String    @default("active") // "active" | "ended"
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([granterId, status])
  @@index([requesterId, status])
}

// A 1:1 DM thread between two profiles. profileAId/profileBId are always
// stored in canonical (lower id first) order so a conversation between the
// same two profiles can never be created twice under swapped ids.
model Conversation {
  id            String   @id @default(cuid())
  profileAId    String
  profileBId    String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages DirectMessage[]

  @@unique([profileAId, profileBId])
  @@index([profileAId])
  @@index([profileBId])
}

model DirectMessage {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderProfileId String
  text            String?
  mediaUrl        String?
  mediaType       String? // "image" | "video"
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// A single, continuous support chat per profile (feature 10) — one
// running thread, not a list of tickets, hence profileId being @unique
// rather than following Conversation/DirectMessage's two-profile shape.
// Separate from those models on purpose: they're hard-wired to two real
// profiles with no room for an assistant turn.
model SupportConversation {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  text           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

// A directed suppression edge — same shape as Follow, opposite intent.
// "block" is mutual: it also blocks new conversations/WayRequests between
// the two and hides each from the other's search results. "mute" is
// one-directional and silent: it only hides targetProfileId's posts from
// actorProfileId's own feed; the muted profile is never told and is
// unaffected everywhere else.
model Block {
  id              String   @id @default(cuid())
  actorProfileId  String
  targetProfileId String
  type            String // "block" | "mute" | "access_request" (narrow, one-directional: only suppresses new ProfileAccessRequests, see lib/blocking.ts's isAccessRequestBlocked)
  createdAt       DateTime @default(now())

  @@unique([actorProfileId, targetProfileId, type])
  @@index([targetProfileId])
}

// A flag on a profile, post, or comment for moderation review. Mirrors
// WayRequest's status-string convention; nothing currently automates
// processing these beyond recording them.
model Report {
  id                String   @id @default(cuid())
  reporterProfileId String
  targetType        String // "profile" | "post" | "comment"
  targetId          String
  reason            String
  status            String   @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt         DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

// An ephemeral status update (photo/video/text), visible for 24h from
// creation. expiresAt is set once at creation rather than computed on
// read, so every query just filters `expiresAt > now()` — no cron/cleanup
// job needed. Visibility follows the profile's own isVisible switch (the
// agreed-on rule: status visibility = profile visibility settings), not a
// separate per-status flag.
model Status {
  id              String   @id @default(cuid())
  profileId       String
  mediaUrl        String?
  mediaType       String? // "image" | "video"
  caption         String?
  backgroundColor String? // for a text-only status card
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([profileId, expiresAt])
}

// A persisted, in-app record of an event worth notifying someone about —
// written alongside (not instead of) the existing push-notify call at each
// trigger point, so push stays "fire and forget" while this is what the
// notifications center actually reads/paginates/marks-read.
model Notification {
  id                     String   @id @default(cuid())
  profileId              String // recipient
  type                   String // "like" | "comment" | "follow" | "way_request" | "way_request_accepted" | "way_request_declined" | "camera_request" | "go_live" | "profile_access_request" | "profile_access_response"
  actorProfileId         String?
  postId                 String?
  episodeId              String?
  profileAccessRequestId String?
  wayRequestId           String?
  read                   Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, read])
}

// A user-submitted "this should be a category" suggestion, surfaced to the
// admin inbox (see requireAdminSecret's note: no admin role system yet,
// just the one owner reviewing via GET/POST /admin/category-suggestions,
// same lazy curl/Postman-driven pattern as business verification). Approving
// one doesn't auto-add it anywhere — the fixed category list mobile ships
// (mobile/src/lib/interests.ts) is static, so "implementing" an approved
// suggestion today means a developer adds it there and ships an update;
// this table is the intake queue, not a live-editable category store.
model CategorySuggestion {
  id            String    @id @default(cuid())
  text          String
  suggestedById String
  status        String    @default("pending") // "pending" | "approved" | "rejected"
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
}

// A voice/video call hanging off an existing DM Conversation — calls are
// always between the two people already in that thread. roomName is the
// LiveKit room id (derived from this row's own id, see routes/calls.ts),
// not stored separately on Conversation since a conversation can have many
// calls over time.
model Call {
  id              String    @id @default(cuid())
  conversationId  String
  callerProfileId String
  calleeProfileId String
  type            String // "voice" | "video"
  status          String    @default("ringing") // "ringing" | "accepted" | "declined" | "missed" | "ended"
  roomName        String
  createdAt       DateTime  @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([calleeProfileId, status])
}

// A business-kind profile's request to be verified (the checkmark badge —
// see Profile.isVerified). lookupResult/lookupSource snapshot whatever
// lib/dojah.ts or lib/cacLookup.ts returned for rcNumber at submission
// time, so the admin reviewing it sees the registry data as it was then,
// not a live re-fetch. A human always makes the actual decide call — the
// lookup only informs it. escalatedAt is set the first time an admin list
// request notices this one is still pending past the 5-day mark, so that
// reminder fires exactly once per request rather than on every page load.
model BusinessVerificationRequest {
  id              String    @id @default(cuid())
  profileId       String
  rcNumber        String
  companyType     String // "BUSINESS_NAME" | "COMPANY" | "INCORPORATED_TRUSTEES" | "LIMITED_PARTNERSHIP" | "LIMITED_LIABILITY_PARTNERSHIP"
  documentUrls    String[]  @default([])
  status          String    @default("pending") // "pending" | "verified" | "rejected"
  // True when this profile has a prior *rejected* request — a business
  // trying again after being turned down once warrants a closer look than
  // a first-time submission, so admins can filter/tab these separately.
  isResubmission  Boolean   @default(false)
  lookupSource    String? // "dojah" | "apify" | null when neither was configured at submission time
  lookupResult    Json?
  submittedAt     DateTime  @default(now())
  decidedAt       DateTime?
  rejectionReason String?
  escalatedAt     DateTime?

  @@index([profileId, submittedAt])
  @@index([status, submittedAt])
}
