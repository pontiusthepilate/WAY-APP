DATABASE_URL="postgresql://way:way@localhost:5432/way_dev"
JWT_SECRET="change-me-in-production"
PORT=4000

# Used to build absolute URLs for uploaded media (POST /uploads) when the
# request's own Host header isn't reliable (e.g. behind a proxy/tunnel).
# Leave unset to fall back to the request's own protocol+host.
PUBLIC_BASE_URL=

# Real SMS (Africa's Talking) / email (Resend) OTP delivery. When these are
# unset, OTP codes are logged to the server console and echoed back in the
# API response instead (dev-only fallback) — see lib/notify.ts.
# SMS uses Africa's Talking rather than a generic/US SMS API because a plain
# international long code isn't reliably deliverable to Nigerian numbers
# (this app's default market) — MTN, Airtel, and 9mobile reject numeric
# international sender IDs. AFRICASTALKING_USERNAME is "sandbox" for testing
# (no real delivery) or your app's username from the dashboard for
# production. AFRICASTALKING_SENDER_ID is optional (a registered
# shortcode/alphanumeric ID); omit it to use the account's default sender.
# RESEND_FROM_EMAIL can be "onboarding@resend.dev" for testing with zero
# setup, or your own address once its domain is verified in Resend.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Address/Location search geocoding (Google Geocoding API). Without this,
# ADDRESS search and free-text LOCATION search return a clear error; NEARBY
# search (device GPS) doesn't need it.
GOOGLE_MAPS_API_KEY=

# Real card funding for the wallet (NGN only for now — see lib/paystack.ts).
# Without this, "fund with card" falls back to an instant simulated credit,
# same as before this was wired up.
PAYSTACK_SECRET_KEY=
# Where Paystack's hosted checkout redirects after payment. Must match the
# mobile app's URL scheme ("way" — see mobile/app.json) so the OS hands
# control back to the app instead of opening a browser dead end.
PAYSTACK_CALLBACK_URL="way://wallet-fund-callback"

# Podcast-profile recurring subscription (see routes/subscriptions.ts).
# Create the recurring Plan via Paystack's API (POST /plan) or dashboard,
# then put its plan_code here. Without this, podcast-profile creation
# returns a clear "not configured" error instead of silently working.
PAYSTACK_PODCAST_PLAN_CODE=
PAYSTACK_PODCAST_CALLBACK_URL="way://podcast-subscribe-callback"

# Voice/video calling (see lib/livekit.ts). Create a project at
# https://cloud.livekit.io for these. Without them, /calls still creates
# the call row and sends the ring notification, but the join token comes
# back null.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# iOS VoIP push for CallKit (see lib/apnsVoipPush.ts). Create a .p8 Auth
# Key with APNs enabled in the Apple Developer portal; APNS_VOIP_KEY_ID is
# that key's ID, APNS_VOIP_TEAM_ID is your Apple Developer Team ID.
# Without these, VoIP pushes are skipped (logged, not sent) — calling
# still works with the app foregrounded via the regular push notification.
APNS_VOIP_KEY_ID=
APNS_VOIP_TEAM_ID=
APNS_VOIP_KEY_P8=

# Business-profile verification (see routes/businessVerification.ts).
# Dojah's CAC lookup (lib/dojah.ts) is the primary data source — AppId and
# secret key come from your Dojah dashboard once compliance review clears;
# DOJAH_LIVE=1 switches from https://sandbox.dojah.io to the real endpoint.
# Without these, falls back to the Apify scraper below; without either,
# falls back further to documents-only manual review.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_LIVE=

# Interim CAC (business RC number) registry lookup via a third-party Apify
# Actor (see lib/cacLookup.ts) — stands in for lib/dojah.ts while a Dojah
# compliance review is pending. Get a token at
# https://console.apify.com/settings/integrations (free account, no card
# needed). Without this, the lookup is skipped and business verification
# falls back to documents-only manual review.
APIFY_API_TOKEN=

# Shared secret gating the bare-bones /admin/business-verification routes —
# there's no admin user/role system yet, just this one header check. Pick
# any long random string; admin requests must send it as X-Admin-Secret.
# Routes are unreachable (not open) while this is unset.
ADMIN_API_SECRET=

# Semantic "Which Way" profile search (lib/voyage.ts, lib/geo.ts) — get a
# key at https://dashboard.voyageai.com/organization/api-keys (voyage-4-lite
# has a 200M free-token allowance). Without this, "describe" searches fall
# back to plain word-overlap matching, same as before this existed.
VOYAGE_API_KEY=

# AI content moderation (lib/moderation.ts) — screens post/comment/chat/
# DM text and uploaded images via Claude before they're saved. Without
# this, moderation is a no-op (pure pass-through) — same fail-open
# behavior as a transient API error, see lib/moderation.ts's doc comment.
# Also powers search-intent parsing, Which Way suggestions, and episode
# show notes — see lib/searchIntent.ts, lib/profileSuggestions.ts,
# lib/episodeShowNotes.ts.
ANTHROPIC_API_KEY=

# Podcast episode transcription (lib/transcription.ts) — get a key at
# https://console.deepgram.com/signup?jump=keys ($200 free credit, no
# card needed). Without this, new episodes get transcriptStatus: "none"
# and no transcription is attempted — not a failure, just inactive.
DEEPGRAM_API_KEY=
