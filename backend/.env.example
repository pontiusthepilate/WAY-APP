DATABASE_URL="postgresql://way:way@localhost:5432/way_dev"
JWT_SECRET="change-me-in-production"
PORT=4000

# Used to build absolute URLs for uploaded media (POST /uploads) when the
# request's own Host header isn't reliable (e.g. behind a proxy/tunnel).
# Leave unset to fall back to the request's own protocol+host.
PUBLIC_BASE_URL=

# Real SMS (Africa's Talking) / email (Resend) OTP delivery. When these are
# unset, OTP codes are logged to the server console and echoed back in the
# API response instead (dev-only fallback) — see lib/notify.ts.
# SMS uses Africa's Talking rather than a generic/US SMS API because a plain
# international long code isn't reliably deliverable to Nigerian numbers
# (this app's default market) — MTN, Airtel, and 9mobile reject numeric
# international sender IDs. AFRICASTALKING_USERNAME is "sandbox" for testing
# (no real delivery) or your app's username from the dashboard for
# production. AFRICASTALKING_SENDER_ID is optional (a registered
# shortcode/alphanumeric ID); omit it to use the account's default sender.
# RESEND_FROM_EMAIL can be "onboarding@resend.dev" for testing with zero
# setup, or your own address once its domain is verified in Resend.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Address/Location search geocoding (Google Geocoding API). Without this,
# ADDRESS search and free-text LOCATION search return a clear error; NEARBY
# search (device GPS) doesn't need it.
GOOGLE_MAPS_API_KEY=

# Real card funding for the wallet (NGN only for now — see lib/paystack.ts).
# Without this, "fund with card" falls back to an instant simulated credit,
# same as before this was wired up.
PAYSTACK_SECRET_KEY=
# Where Paystack's hosted checkout redirects after payment. Must match the
# mobile app's URL scheme ("way" — see mobile/app.json) so the OS hands
# control back to the app instead of opening a browser dead end.
PAYSTACK_CALLBACK_URL="way://wallet-fund-callback"
