DATABASE_URL="postgresql://way:way@localhost:5432/way_dev"
JWT_SECRET="change-me-in-production"
PORT=4000

# Used to build absolute URLs for uploaded media (POST /uploads) when the
# request's own Host header isn't reliable (e.g. behind a proxy/tunnel).
# Leave unset to fall back to the request's own protocol+host.
PUBLIC_BASE_URL=

# When these are unset, OTP codes are logged to the server console and echoed
# back in the API response (dev-only) instead of actually being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Address/Location search geocoding (Google Geocoding API). Without this,
# ADDRESS search and free-text LOCATION search return a clear error; NEARBY
# search (device GPS) doesn't need it.
GOOGLE_MAPS_API_KEY=

# Real card funding for the wallet (NGN only for now — see lib/paystack.ts).
# Without this, "fund with card" falls back to an instant simulated credit,
# same as before this was wired up.
PAYSTACK_SECRET_KEY=
# Where Paystack's hosted checkout redirects after payment. Must match the
# mobile app's URL scheme ("way" — see mobile/app.json) so the OS hands
# control back to the app instead of opening a browser dead end.
PAYSTACK_CALLBACK_URL="way://wallet-fund-callback"
